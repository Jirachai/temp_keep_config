# Do not edit this file manually!
# It will be overwritten by Patroni!
include 'postgresql.base.conf'

autovacuum_vacuum_cost_limit = '3000'
checkpoint_completion_target = '0.9'
cluster_name = 'prd-init'
default_statistics_target = '100'
effective_cache_size = '6GB'
effective_io_concurrency = '200'
hot_standby = 'on'
huge_pages = 'try'
listen_addresses = '0.0.0.0'
maintenance_work_mem = '512MB'
max_connections = '1000'
max_locks_per_transaction = '64'
max_parallel_maintenance_workers = '2'
max_parallel_workers = '4'
max_parallel_workers_per_gather = '2'
max_prepared_transactions = '0'
max_replication_slots = '10'
max_stack_depth = '6MB'
max_wal_senders = '10'
max_wal_size = '4GB'
max_worker_processes = '8'
min_wal_size = '1GB'
port = '5432'
random_page_cost = '1.1'
shared_buffers = '2GB'
shared_preload_libraries = 'pg_stat_statements'
track_commit_timestamp = 'off'
unix_socket_directories = '.'
wal_buffers = '16MB'
wal_compression = 'on'
wal_keep_size = '128MB'
wal_level = 'replica'
wal_log_hints = 'on'
work_mem = '1048kB'
hba_file = '/var/lib/patroni/data/node/pg_hba.conf'
ident_file = '/var/lib/patroni/data/node/pg_ident.conf'

# recovery.conf
primary_conninfo = 'dbname=postgres user=replicator passfile=/tmp/pgpass1 host=10.141.1.226 port=5432 sslmode=prefer application_name=member_0 gssencmode=prefer channel_binding=prefer sslnegotiation=postgres'
primary_slot_name = 'member_0'
recovery_target = ''
recovery_target_lsn = ''
recovery_target_name = ''
recovery_target_time = ''
recovery_target_timeline = 'latest'
recovery_target_xid = ''
